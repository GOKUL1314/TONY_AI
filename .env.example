# TONY AI Assistant - Environment Configuration Example

# ==============================================================================
# STAGE 1: AI Provider Selection
# ==============================================================================
AI_PROVIDER=local
AI_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434

API_KEY=
API_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# STAGE 2: Voice System Configuration (STT / TTS)
# ==============================================================================
STT_PROVIDER=whisper
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

TTS_PROVIDER=local
TTS_VOICE=default
TTS_RATE=175

# ==============================================================================
# STAGE 3: Continuous Conversation & Hands-Free Settings
# ==============================================================================
CONTINUOUS_MODE=true
WAKE_WORD_ENABLED=true
WAKE_WORD=tony
WAKE_WORD_CONFIDENCE=0.65
WAKE_WORD_COOLDOWN_MS=1500
VOICE_SILENCE_TIMEOUT=1.2
MICROPHONE_ENABLED=true
AUDIO_DUCKING=true

# ==============================================================================
# STAGE 4: Long-Term Memory & Context Settings (SQLite)
# ==============================================================================
MEMORY_ENABLED=true
MEMORY_DATABASE=data/memory.db
MEMORY_AUTO_SAVE=true
MEMORY_SEMANTIC_SEARCH=false
MEMORY_MAX_RESULTS=5
MEMORY_MIN_RELEVANCE=0.15

# ==============================================================================
# STAGE 5: Tool Execution & Safe Windows Automation Settings
# ==============================================================================
TOOLS_ENABLED=true
TOOL_CONFIRMATION_ENABLED=true
TOOL_CONFIRMATION_TIMEOUT=60
TOOL_MAX_SEARCH_RESULTS=20
TOOLS_ALLOW_FILE_OPERATIONS=true
TOOLS_ALLOW_APPLICATIONS=true
TOOLS_ALLOW_BROWSER=true
TOOLS_ALLOW_VOLUME=true
TOOLS_ALLOW_MEDIA=true

# ==============================================================================
# STAGE 6: Image Generation Settings (Free-First: pollinations | mock | openai)
# ==============================================================================
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=sana
POLLINATIONS_API_BASE_URL=https://image.pollinations.ai

# Optional Cloud Provider (OpenAI DALL-E 3)
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_DEFAULT_WIDTH=1024
IMAGE_DEFAULT_HEIGHT=1024
IMAGE_MAX_HISTORY=100
IMAGE_TIMEOUT=60
IMAGE_PROMPT_ENHANCEMENT=true

# ==============================================================================
# STAGE 7: Video Generation Settings (Free-First / Cost-Safe)
# ==============================================================================
VIDEO_PROVIDER=huggingface
VIDEO_ALLOW_PAID=false

HF_TOKEN=
HF_VIDEO_PROVIDER=wavespeed
HF_PROVIDER=wavespeed
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-14B

VIDEO_LOCAL_MODEL=
VIDEO_LOCAL_MODEL_PATH=
VIDEO_LOCAL_DEVICE=auto

VIDEO_DEFAULT_DURATION=5
VIDEO_MAX_DURATION=5
VIDEO_DEFAULT_WIDTH=512
VIDEO_DEFAULT_HEIGHT=512
VIDEO_DEFAULT_FPS=16
VIDEO_TIMEOUT=300
VIDEO_MAX_CONCURRENT_JOBS=1
VIDEO_PROMPT_ENHANCEMENT=true
RUN_REAL_VIDEO_TEST=false

# ==============================================================================
# STAGE 9: Vision & Image Understanding Settings (Ollama Moondream / Mock)
# ==============================================================================
VISION_PROVIDER=ollama
VISION_MODEL=moondream
VISION_MAX_FILE_SIZE_MB=10
VISION_TIMEOUT=90
VISION_MAX_HISTORY=100

# ==============================================================================
# STAGE 11: Personal Knowledge & RAG System Settings
# ==============================================================================
KNOWLEDGE_ENABLED=true
KNOWLEDGE_EMBEDDING_PROVIDER=ollama
KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MAX_FILE_SIZE_MB=25
KNOWLEDGE_SEMANTIC_WEIGHT=0.65
KNOWLEDGE_KEYWORD_WEIGHT=0.35

# ==============================================================================
# STAGE 12: Personalization & Proactive Intelligence Settings
# ==============================================================================
PERSONALIZATION_ENABLED=true
PROACTIVE_ENABLED=false
PROACTIVE_DAILY_BRIEFING_ENABLED=false
PROACTIVE_EVENING_SUMMARY_ENABLED=false
PROACTIVE_QUIET_HOURS_START=22:00
PROACTIVE_QUIET_HOURS_END=07:00
PROACTIVE_MAX_NOTIFICATIONS_PER_DAY=5
PROACTIVE_TIMEZONE=Asia/Kolkata
PROACTIVE_DAILY_BRIEFING_TIME=08:00
PROACTIVE_EVENING_SUMMARY_TIME=21:00

# ==============================================================================
# Server Settings
# ==============================================================================
HOST=127.0.0.1
PORT=5000
DEBUG=True
SECRET_KEY=tony-ai-secret-key-dev



